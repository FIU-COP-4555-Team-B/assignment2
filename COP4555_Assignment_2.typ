= Grammar Derivations

#set heading(numbering: "1.a")

Given the grammar with start symbol $S$:

#grammar[
  #raw(block: true, lang: "text", "S -> 0Y | 1X\nX -> 0 | 0S | 1XX\nY -> 1 | 1S | 0YY")
]

== 00110101

#answer[
  #raw(
    block: true,
    lang: "text",
    "S\n-> 0Y\n-> 00YY\n-> 001SY\n-> 0011XY\n-> 00110SY\n-> 001101XY\n-> 0011010Y\n-> 00110101",
  )
]

== 1101101

#answer[
  The string can not be generated by the grammar. Starting from $S -> 1X$ has us needing terminal symbols incompatible with the remaining suffixes.
]

== 110001

#answer[
  #raw(block: true, lang: "text", "S\n-> 1X\n-> 11XX\n-> 110X\n-> 1100S\n-> 11000Y\n-> 110001")
]

