= Parse Trees

#set heading(numbering: "1.1")

Given the grammar:

#grammar[
  #raw(
    block: true,
    lang: "text",
    "<assign>     -> <identifier> = <expression>\n<identifier> -> A | B | C\n<expression> -> <expression> + <term> | <term>\n<term>       -> <term> * <factor> | <factor>\n<factor>     -> ( <expression> ) | <identifier>",
  )
]

== A = A + (B + C \* A)

#parse-tree(text-size: 7.5pt, spacing: (4pt, 11pt))[
  - `<assign>`
    - `<identifier>`
      - `A`
    - `=`
    - `<expression>`
      - `<expression>`
        - `<term>`
          - `<factor>`
            - `<identifier>`
              - `A`
      - `+`
      - `<term>`
        - `<factor>`
          - `(`
          - `<expression>`
            - `<expression>`
              - `<term>`
                - `<factor>`
                  - `<identifier>`
                    - `B`
            - `+`
            - `<term>`
              - `<term>`
                - `<factor>`
                  - `<identifier>`
                    - `C`
              - `*`
              - `<factor>`
                - `<identifier>`
                  - `A`
          - `)`
]

== B = C * (A * C + B)

#parse-tree(text-size: 7.5pt, spacing: (4pt, 11pt))[
  - `<assign>`
    - `<identifier>`
      - `B`
    - `=`
    - `<expression>`
      - `<term>`
        - `<term>`
          - `<factor>`
            - `<identifier>`
              - `C`
        - `*`
        - `<factor>`
          - `(`
          - `<expression>`
            - `<expression>`
              - `<term>`
                - `<term>`
                  - `<factor>`
                    - `<identifier>`
                      - `A`
                - `*`
                - `<factor>`
                  - `<identifier>`
                    - `C`
            - `+`
            - `<term>`
              - `<factor>`
                - `<identifier>`
                  - `B`
          - `)`
]

